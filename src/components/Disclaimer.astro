---
import { t } from '@/i18n/utils';

interface Props {
  customDisclaimer?: string;
}

const { customDisclaimer } = Astro.props;

// Default disclaimer text
const defaultDisclaimer = t('post.defaultDisclaimer');

// Use custom disclaimer if provided, otherwise use default
const disclaimerText = customDisclaimer || defaultDisclaimer;
---

<section class="disclaimer-section">
  <div class="disclaimer-container">
    <div class="disclaimer-header">
      <svg class="disclaimer-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/>
        <line x1="12" y1="8" x2="12" y2="12"/>
        <line x1="12" y1="16" x2="12.01" y2="16"/>
      </svg>
      <h3 class="disclaimer-title">
        <span data-translate="post.disclaimer">{t('post.disclaimer')}</span>
      </h3>
    </div>
    <div class="disclaimer-content">
      <p>{disclaimerText}</p>
    </div>
  </div>
</section>

<style>
  .disclaimer-section {
    margin-top: 3rem;
    margin-bottom: 2rem;
    padding: 0;
  }

  .disclaimer-container {
    background: linear-gradient(135deg, rgb(var(--color-accent) / 0.05) 0%, rgb(var(--color-accent) / 0.1) 100%);
    border-left: 4px solid rgb(var(--color-accent));
    border-radius: 0.5rem;
    padding: 1.5rem;
    box-shadow: 0 2px 8px rgb(var(--color-text-base) / 0.05);
    transition: all 0.3s ease;
  }

  .disclaimer-container:hover {
    box-shadow: 0 4px 12px rgb(var(--color-text-base) / 0.1);
    transform: translateY(-2px);
  }

  .disclaimer-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .disclaimer-icon {
    width: 1.5rem;
    height: 1.5rem;
    color: rgb(var(--color-accent));
    flex-shrink: 0;
  }

  .disclaimer-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: rgb(var(--color-text-base));
    margin: 0;
    letter-spacing: 0.025em;
  }

  .disclaimer-content {
    padding-left: 2.25rem;
    color: rgb(var(--color-text-base) / 0.85);
    line-height: 1.7;
  }

  .disclaimer-content p {
    margin: 0;
    font-size: 0.95rem;
  }

  @media (max-width: 640px) {
    .disclaimer-container {
      padding: 1.25rem;
    }

    .disclaimer-header {
      gap: 0.5rem;
    }

    .disclaimer-icon {
      width: 1.25rem;
      height: 1.25rem;
    }

    .disclaimer-title {
      font-size: 1rem;
    }

    .disclaimer-content {
      padding-left: 1.75rem;
      font-size: 0.9rem;
    }
  }
</style>
