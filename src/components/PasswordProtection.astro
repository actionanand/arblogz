---
import { passwordProtection } from '@/consts';
import '@/styles/password-protection.css';

interface Props {
  passwordProtected?: boolean;
}

const { passwordProtected } = Astro.props;

// Determine if password protection should be enabled
// Priority: frontmatter passwordProtected > global enable
const isProtected = passwordProtected !== undefined 
  ? passwordProtected 
  : passwordProtection.enable;
---

<!-- Always render content, show lock overlay only if needed -->
<slot />

{isProtected && (
  <>
    <!-- Lock Status Badge - Shows when content is unlocked -->
    <div id="lock-status-badge" class="lock-status-badge pw-hidden" title="Click to lock content again">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 5-5 5 5 0 0 1 5 5v4"></path>
      </svg>
      <span class="lock-status-badge-text">Protected Content</span>
    </div>

    <!-- Lock Screen Overlay -->
    <div id="password-lock-overlay" class="password-lock-overlay">
      <div class="password-lock-modal">
        <div class="password-lock-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </div>
        
        <h2 class="password-lock-title">{passwordProtection.title}</h2>
        <p class="password-lock-message">{passwordProtection.message}</p>
        
        <form id="password-lock-form" class="password-lock-form">
          <div class="password-input-wrapper">
            <input
              type="password"
              id="password-input"
              class="password-lock-input"
              placeholder={passwordProtection.placeholder}
              autocomplete="off"
              required
            />
            <button type="button" id="toggle-password" class="toggle-password-btn" aria-label="Toggle password visibility">
              <svg id="eye-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
              <svg id="eye-off-icon" class="pw-hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                <line x1="1" y1="1" x2="23" y2="23"></line>
              </svg>
            </button>
          </div>
          
          <button type="submit" id="unlock-button" class="password-lock-button">
            <span id="button-text">{passwordProtection.buttonText}</span>
            <span id="loading-spinner" class="loading-spinner pw-hidden">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
              </svg>
            </span>
          </button>
          
          <div id="error-message" class="password-lock-error pw-hidden">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="15" y1="9" x2="9" y2="15"></line>
              <line x1="9" y1="9" x2="15" y2="15"></line>
            </svg>
            <span id="error-text">{passwordProtection.errorMessage}</span>
          </div>
          
          <div id="success-message" class="password-lock-success pw-hidden">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M9 12l2 2 4-4"></path>
            </svg>
            <span>{passwordProtection.successMessage}</span>
          </div>
        </form>
      </div>
    </div>
  </>
)}

<script define:vars={{ passwordHash: passwordProtection.passwordHash, storageKey: passwordProtection.storageKey, sessionTimeout: passwordProtection.sessionTimeout }}>
  // SHA1 hash function
  async function sha1(str) {
    const buffer = new TextEncoder().encode(str);
    const hashBuffer = await crypto.subtle.digest('SHA-1', buffer);
    const hashArray = Array.from(new Uint8Array(hashBuffer));
    return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
  }

  // Check authentication on page load
  function checkAuth() {
    const overlay = document.getElementById('password-lock-overlay');
    if (!overlay) return true; // No protection enabled

    const stored = localStorage.getItem(storageKey);
    
    if (!stored) {
      return false;
    }

    try {
      const authData = JSON.parse(stored);
      const { hash, timestamp } = authData;

      // Check if hash matches
      if (hash !== passwordHash) {
        localStorage.removeItem(storageKey);
        return false;
      }

      // Check if session has expired (if timeout is set)
      if (sessionTimeout > 0) {
        const now = Date.now();
        if (now - timestamp > sessionTimeout) {
          localStorage.removeItem(storageKey);
          return false;
        }
      }

      return true;
    } catch (e) {
      localStorage.removeItem(storageKey);
      return false;
    }
  }

  // Unlock content
  function unlockContent() {
    const overlay = document.getElementById('password-lock-overlay');
    const badge = document.getElementById('lock-status-badge');
    
    if (overlay) {
      overlay.classList.add('pw-hidden');
    }
    
    if (badge) {
      badge.classList.remove('pw-hidden');
    }
  }

  // Lock content
  function lockContent() {
    const overlay = document.getElementById('password-lock-overlay');
    const badge = document.getElementById('lock-status-badge');
    const unlockButton = document.getElementById('unlock-button');
    const buttonText = document.getElementById('button-text');
    const loadingSpinner = document.getElementById('loading-spinner');
    const passwordInput = document.getElementById('password-input');
    const errorDiv = document.getElementById('error-message');
    const successDiv = document.getElementById('success-message');
    
    if (overlay) {
      overlay.classList.remove('pw-hidden');
    }
    
    if (badge) {
      badge.classList.add('pw-hidden');
    }
    
    // Reset form state
    if (unlockButton) unlockButton.disabled = false;
    if (buttonText) buttonText.classList.remove('pw-hidden');
    if (loadingSpinner) loadingSpinner.classList.add('pw-hidden');
    if (passwordInput) passwordInput.value = '';
    if (errorDiv) errorDiv.classList.add('pw-hidden');
    if (successDiv) successDiv.classList.add('pw-hidden');
  }

  // Initialize on page load
  if (checkAuth()) {
    unlockContent();
  }

  // Toggle password visibility
  const toggleBtn = document.getElementById('toggle-password');
  const passwordInput = document.getElementById('password-input');
  const eyeIcon = document.getElementById('eye-icon');
  const eyeOffIcon = document.getElementById('eye-off-icon');

  if (toggleBtn && passwordInput && eyeIcon && eyeOffIcon) {
    toggleBtn.addEventListener('click', () => {
      const isPassword = passwordInput.type === 'password';
      passwordInput.type = isPassword ? 'text' : 'password';
      eyeIcon.classList.toggle('pw-hidden');
      eyeOffIcon.classList.toggle('pw-hidden');
    });
  }

  // Handle form submission
  const form = document.getElementById('password-lock-form');
  const errorDiv = document.getElementById('error-message');
  const errorText = document.getElementById('error-text');
  const successDiv = document.getElementById('success-message');
  const unlockButton = document.getElementById('unlock-button');
  const buttonText = document.getElementById('button-text');
  const loadingSpinner = document.getElementById('loading-spinner');

  if (form && passwordInput) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      // Clear previous messages
      if (errorDiv) errorDiv.classList.add('pw-hidden');
      if (successDiv) successDiv.classList.add('pw-hidden');
      
      // Show loading state
      if (unlockButton) unlockButton.disabled = true;
      if (buttonText) buttonText.classList.add('pw-hidden');
      if (loadingSpinner) loadingSpinner.classList.remove('pw-hidden');

      try {
        const inputPassword = passwordInput.value;
        const hash = await sha1(inputPassword);

        if (hash === passwordHash) {
          // Success
          if (successDiv) successDiv.classList.remove('pw-hidden');
          
          // Store auth token
          const authData = {
            hash: passwordHash,
            timestamp: Date.now()
          };
          localStorage.setItem(storageKey, JSON.stringify(authData));

          // Unlock content after brief delay
          setTimeout(() => {
            // Reset form state before unlocking
            if (unlockButton) unlockButton.disabled = false;
            if (buttonText) buttonText.classList.remove('pw-hidden');
            if (loadingSpinner) loadingSpinner.classList.add('pw-hidden');
            if (successDiv) successDiv.classList.add('pw-hidden');
            if (passwordInput) passwordInput.value = '';
            
            unlockContent();
          }, 800);
        } else {
          // Error - wrong password
          if (errorDiv) {
            errorDiv.classList.remove('pw-hidden');
            errorDiv.classList.add('shake');
            setTimeout(() => {
              errorDiv.classList.remove('shake');
            }, 400);
          }
          
          // Reset form
          if (unlockButton) unlockButton.disabled = false;
          if (buttonText) buttonText.classList.remove('pw-hidden');
          if (loadingSpinner) loadingSpinner.classList.add('pw-hidden');
          passwordInput.value = '';
          passwordInput.focus();
        }
      } catch (error) {
        console.error('Password verification error:', error);
        if (errorDiv && errorText) {
          errorText.textContent = 'An error occurred. Please try again.';
          errorDiv.classList.remove('pw-hidden');
        }
        
        // Reset form
        if (unlockButton) unlockButton.disabled = false;
        if (buttonText) buttonText.classList.remove('pw-hidden');
        if (loadingSpinner) loadingSpinner.classList.add('pw-hidden');
      }
    });
  }

  // Lock status badge functionality - Re-lock content
  const lockBadge = document.getElementById('lock-status-badge');
  if (lockBadge) {
    lockBadge.addEventListener('click', () => {
      // Clear authentication
      localStorage.removeItem(storageKey);
      
      // Show lock screen again
      lockContent();
      
      // Reset form
      if (passwordInput) passwordInput.value = '';
      if (errorDiv) errorDiv.classList.add('pw-hidden');
      if (successDiv) successDiv.classList.add('pw-hidden');
    });
  }
</script>
