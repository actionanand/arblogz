---
import { getCollection } from 'astro:content';
import { t } from '@/i18n/utils';

interface Props {
  relatedSlugs: string[];
}

const { relatedSlugs = [] } = Astro.props;

// Fetch all blog posts
const allPosts = await getCollection('blog');

// Filter and validate related posts (max 5)
const relatedPosts = relatedSlugs
  .slice(0, 5) // Take only first 5
  .map(slug => {
    // Remove .md or .mdx extension if present
    const cleanSlug = slug.replace(/\.(md|mdx)$/i, '');
    
    // Find the post by slug
    return allPosts.find(post => post.slug === cleanSlug);
  })
  .filter(post => post !== undefined); // Remove invalid posts

// Don't render if no valid related posts
if (relatedPosts.length === 0) {
  return null;
}

// Format date helper
const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat(Astro.currentLocale || 'en', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  }).format(date);
};
---

<section class="related-articles-section">
  <div class="related-articles-header">
    <h2 class="related-articles-title">
      <svg class="related-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
      </svg>
      <span data-translate="post.relatedArticles">{t('post.relatedArticles')}</span>
    </h2>
    <p class="related-articles-subtitle"><span data-translate="post.continueExploring">{t('post.continueExploring')}</span></p>
  </div>
  
  <div class="related-articles-grid">
    {relatedPosts.map((post) => (
      <a href={`/blog/${post.slug}`} class="related-article-card">
        <div class="card-content">
          <div class="card-header">
            {post.data.category && (
              <span class="card-category">
                {Array.isArray(post.data.category) ? post.data.category[0] : post.data.category}
              </span>
            )}
            <time class="card-date" datetime={post.data.date.toISOString()}>
              {formatDate(post.data.date)}
            </time>
          </div>
          
          <h3 class="card-title">{post.data.title}</h3>
          
          {post.data.description && (
            <p class="card-description">
              {post.data.description}
            </p>
          )}
          
          <div class="card-footer">
            <span class="read-more">
              <span data-translate="post.readArticle">{t('post.readArticle')}</span>
              <svg class="arrow-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </span>
          </div>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .related-articles-section {
    margin-top: 4rem;
    margin-bottom: 3rem;
    padding: 2rem 0;
    border-top: 2px solid rgb(var(--color-border) / 0.3);
  }

  .related-articles-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .related-articles-title {
    font-size: 1.875rem;
    font-weight: 700;
    color: rgb(var(--color-text-heading));
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }
  
  /* Light mode specific heading color */
  @media (prefers-color-scheme: light) {
    .related-articles-title {
      color: #635C59;
    }
  }

  .related-icon {
    width: 2rem;
    height: 2rem;
    color: rgb(var(--color-border-active));
    flex-shrink: 0;
  }

  .related-articles-subtitle {
    font-size: 1rem;
    color: rgb(var(--color-text-muted));
    font-weight: 400;
  }

  .related-articles-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .related-articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .related-articles-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Adjust for 4 or 5 items to make better use of space */
  .related-articles-grid:has(> :nth-child(4):last-child),
  .related-articles-grid:has(> :nth-child(5):last-child) {
    @media (min-width: 1024px) {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .related-article-card {
    display: block;
    background: rgb(var(--color-card-bg));
    border: 1px solid rgb(var(--color-border) / 0.3);
    border-radius: 0.75rem;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none;
    color: inherit;
    position: relative;
    height: 100%;
  }

  .related-article-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, 
      rgb(var(--color-border-active)), 
      rgb(var(--color-accent))
    );
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }

  .related-article-card:hover::before {
    transform: scaleX(1);
  }

  .related-article-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgb(var(--color-border-active) / 0.15);
    border-color: rgb(var(--color-border-active) / 0.5);
  }

  .card-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .card-category {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: rgb(var(--color-border-active) / 0.1);
    color: rgb(var(--color-border-active));
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .card-date {
    font-size: 0.875rem;
    color: #8B8B8B;
    font-weight: 500;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: rgb(var(--color-text-heading));
    margin-bottom: 0.75rem;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.2s ease;
  }
  
  /* Light mode specific card title color */
  @media (prefers-color-scheme: light) {
    .card-title {
      color: #635C59;
    }
  }

  .related-article-card:hover .card-title {
    color: rgb(var(--color-border-active));
  }

  .card-description {
    font-size: 0.9375rem;
    color: rgb(var(--color-text-muted));
    line-height: 1.6;
    margin-bottom: 1.25rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex-grow: 1;
  }

  .card-footer {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid rgb(var(--color-border) / 0.2);
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: rgb(var(--color-border-active));
    transition: gap 0.3s ease;
  }

  .related-article-card:hover .read-more {
    gap: 0.75rem;
  }

  .arrow-icon {
    width: 1.25rem;
    height: 1.25rem;
    transition: transform 0.3s ease;
  }

  .related-article-card:hover .arrow-icon {
    transform: translateX(4px);
  }

  /* Dark mode adjustments */
  @media (prefers-color-scheme: dark) {
    .related-article-card {
      background: rgb(var(--color-card-bg));
      border-color: rgb(var(--color-border) / 0.2);
    }

    .related-article-card:hover {
      box-shadow: 0 12px 24px rgb(0 0 0 / 0.3);
    }
  }

  /* Single item - full width */
  .related-articles-grid:has(> :only-child) {
    @media (min-width: 768px) {
      grid-template-columns: 1fr;
      max-width: 42rem;
      margin: 0 auto;
    }
  }
</style>
