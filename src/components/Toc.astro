---
import {t} from '@/i18n/utils'
---
<div
  id="toc"
  class="shadow-lg rounded-lg my-4 py-2 px-2 bg-skin-card sticky top-20 max-h-[calc(100vh-6rem)]"
>
  <div class="aside-widget">
    <i class="ri-list-check menu-icon"/>
    <span data-translate="blog.tableOfContent">{t('blog.tableOfContent')}</span>
  </div>
  <div class="overflow-auto max-h-[calc(100vh-10rem)]">
    <div class="toc-container"/>
  </div>
</div>

<style>
  .post-title:hover {
    outline: 0;
    color: #cc7a00;
    text-shadow: 1px 1px 1px #ffd147;
  }

  .toc_container {
    overflow-y: scroll;
    /* webkit */
    /* firefox */
    scrollbar-width: none;
    /* ie */
    -ms-overflow-style: none;
  }

  .toc_container::-webkit-scrollbar {
    width: 0;
    height: 0;
  }

  .toc_container a{
    text-overflow: ellipsis;
    white-space: nowrap;
    overflow: hidden;
  }

  /* Heading hierarchy styles */
  .toc-container :global(.toc-list) {
    padding-left: 0;
    list-style: none;
  }

  /* H1 links - largest, boldest */
  .toc-container :global(.toc-list > li > a) {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-base);
    padding: 0.5rem 0;
    display: block;
    opacity: 0.95;
  }

  /* H2 links - medium, semi-bold */
  .toc-container :global(.toc-list .toc-list > li > a) {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-base);
    padding: 0.4rem 0 0.4rem 1rem;
    display: block;
    opacity: 0.85;
    border-left: 2px solid rgba(128, 128, 128, 0.2);
  }

  /* H3 links - smaller, normal weight */
  .toc-container :global(.toc-list .toc-list .toc-list > li > a) {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text-base);
    padding: 0.3rem 0 0.3rem 2rem;
    display: block;
    opacity: 0.75;
    border-left: 2px solid rgba(128, 128, 128, 0.15);
  }

  /* Active/hover states for all levels */
  .toc-container :global(.toc-list > li > a:hover),
  .toc-container :global(.toc-list > li > a.is-active-link) {
    color: #cc7a00;
    opacity: 1;
  }

  .toc-container :global(.toc-list .toc-list > li > a:hover),
  .toc-container :global(.toc-list .toc-list > li > a.is-active-link) {
    color: #cc7a00;
    opacity: 1;
    border-left-color: #cc7a00;
  }

  .toc-container :global(.toc-list .toc-list .toc-list > li > a:hover),
  .toc-container :global(.toc-list .toc-list .toc-list > li > a.is-active-link) {
    color: #cc7a00;
    opacity: 1;
    border-left-color: #cc7a00;
  }

  /* Spacing between items */
  .toc-container :global(.toc-list li) {
    margin: 0.25rem 0;
  }
</style>

<script>
  import * as tocbot from "tocbot";

  tocbot.init({
    tocSelector: ".toc-container",
    contentSelector: ".markdown-body",
    headingSelector: "h1,h2,h3",
    hasInnerContainers: true,
    headingsOffset: 80,
    scrollSmoothOffset: -80,
    scrollSmoothDuration: 200,
    collapseDepth: 3,
    onClick: function (){
      return false
    },
  });
  let toc = document.getElementById("toc");
  if (toc) {
    tocbot.refresh();
    let tocContainer = document.getElementsByClassName('toc-container')
    if (tocContainer[0].textContent.replace(/\s/g, '') === '') {
      toc.classList.toggle('hidden')
    } else {
      toc.classList.add('block')
    }
  }
</script>
