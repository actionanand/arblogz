---
import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Profile from '@/components/Profile.astro'
import Comment from '@/components/Comment.astro'
import Toc from '@/components/Toc.astro'
import Donate from '@/components/Donate.astro';
import RelatedArticles from '@/components/RelatedArticles.astro';
import Disclaimer from '@/components/Disclaimer.astro';
import PasswordProtection from '@/components/PasswordProtection.astro';
import {comment, config, donate} from "@/consts";
import ScrollToTop from '@/components/ScrollToTop.astro'
import {t} from '@/i18n/utils'

const {
  frontmatter = {
    comment: false,
    donate: false,
    toc: false,
    mathjax: false,
    mermaid: false,
    showDonate: undefined, // Can be true, false, or undefined
    donateMessage: undefined,
    customDonate: undefined,
    passwordProtected: undefined, // Can be true, false, or undefined
    showDisclaimer: false, // Can be true or false, default is false
    customDisclaimer: undefined, // Custom disclaimer text
  },
} = Astro.props;

// Donation logic:
// 1. If showDonate is explicitly set (true/false), use that value (manual control overrides all)
// 2. If showDonate is undefined, use global donate.enableForAllBlogs setting
// 3. Global donate.enable must be true for any donations to work
const shouldShowDonate = donate.enable && (
  frontmatter.showDonate !== undefined 
    ? frontmatter.showDonate 
    : donate.enableForAllBlogs
);
---

<html lang={config.lang}>
<BaseHead
  title={frontmatter.title}
  description={frontmatter.description}
  mathjax={frontmatter.mathjax}
  mermaid={frontmatter.mermaid}
  ogImage={frontmatter.ogImage}
/>

<body class="bg-skin-secondary">
<Header/>
<main class="container p-4  pt-20 text-skin-base min-h-full pb-32 relative" id="app">
  <div class="grid grid-cols-4 gap-8">
    <div class="col-span-4 xl:col-span-3 space-y-4 first:space-y-2">
      <button class="flex items-center text-md cursor-pointer hover:text-skin-active outline-none" style="background-color: inherit;" onclick="history.back()">
        <i class="ri-arrow-left-line mr-2"/>
        <span data-translate="home.goBack">{t('home.goBack')}</span>
      </button>
      <PasswordProtection passwordProtected={frontmatter.passwordProtected}>
        <slot/>
      </PasswordProtection>
      
      <!-- Related Articles Section -->
      {
        frontmatter.relatedArticles && frontmatter.relatedArticles.length > 0 && (
          <RelatedArticles relatedSlugs={frontmatter.relatedArticles} />
        )
      }
      
      <!-- Disclaimer Section - Show only when enabled in frontmatter -->
      {
        frontmatter.showDisclaimer && (
          <Disclaimer customDisclaimer={frontmatter.customDisclaimer} />
        )
      }
      
      <!-- Donation Section - Show based on global and manual controls -->
      {
        shouldShowDonate && (
          <Donate 
            showDonate={true}
            donateMessage={frontmatter.donateMessage}
            customDonateConfig={frontmatter.customDonate}
          />
        )
      }
      
      {
        frontmatter.comment && comment.enable &&
        <Comment></Comment>
      }
    </div>
    <div class="hidden xl:block col-span-1 relative">
      <Profile></Profile>
      {
        frontmatter.toc &&
        <Toc></Toc>
      }
    </div>
    <ScrollToTop></ScrollToTop>
  </div>
  <Footer/>
</main>
</body>
</html>


<script>
  import {Fancybox} from "@fancyapps/ui";
  import "@fancyapps/ui/dist/fancybox/fancybox.css";
  import {t} from '@/i18n/utils';

  Fancybox.bind("[data-fancybox]");
  // 给所有的a标签添加target属性和不追踪
  const markdownBody = document.querySelector(".markdown-body");
  // 如果没有markdownBody则直接返回
  if (markdownBody) {
    let images = markdownBody.querySelectorAll("img");
    const callback = (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const image = entry.target;
          const data_src = image.getAttribute("data-src");
          const data_alt = image.getAttribute("data-alt");
          image.setAttribute("data-fancybox", "gallery")
          if (data_src) {
            image.setAttribute("src", data_src);
          }
          if (data_alt) {
            image.setAttribute("alt", data_alt);
          }
          observer.unobserve(image);
        }
      });
    };

    const observer = new IntersectionObserver(callback);
    images.forEach((image) => {
      observer.observe(image);
    });

    // Style footnote references in text with green color
    const footnoteRefs = markdownBody.querySelectorAll('[data-footnote-ref]');
    footnoteRefs.forEach(ref => {
      // Make [1] green in text
      ref.style.color = 'rgb(var(--color-border-active))';
      ref.style.textDecoration = 'none';
      
      // Remove underline on hover
      ref.addEventListener('mouseenter', () => {
        ref.style.textDecoration = 'none';
      });
      
      ref.addEventListener('mouseleave', () => {
        ref.style.textDecoration = 'none';
      });
      
      // Add green highlight to footnotes when navigated via # anchor
      ref.addEventListener('click', () => {
        const targetId = ref.getAttribute('href');
        const target = document.querySelector(targetId);
        if (target) {
          // Wait for native scroll to complete, then highlight
          setTimeout(() => {
            const originalBg = target.style.backgroundColor;
            target.style.backgroundColor = 'rgba(var(--color-border-active), 0.2)';
            target.style.transition = 'background-color 0.3s ease';
            setTimeout(() => {
              target.style.backgroundColor = originalBg;
              setTimeout(() => {
                target.style.transition = '';
              }, 300);
            }, 2500);
          }, 100);
        }
      });
    });
    
    // Change footnote numbering from '1.' to '[1]' with green color
    const footnoteSection = markdownBody.querySelector('.footnotes');
    if (footnoteSection) {
      const footnoteList = footnoteSection.querySelector('ol');
      if (footnoteList) {
        // Hide default list markers
        footnoteList.style.listStyleType = 'none';
        footnoteList.style.paddingLeft = '0';
        
        const footnoteItems = footnoteList.querySelectorAll('li');
        footnoteItems.forEach((item, index) => {
          // Keep text in normal color (reset any green color applied to li)
          item.style.color = '';
          
          // Add custom [1] numbering
          item.style.position = 'relative';
          item.style.paddingLeft = '2rem'; // gap between number and text in footnote citation
          
          // Create and insert [n] before content
          const number = document.createElement('span');
          number.textContent = `[${index + 1}]`;
          number.style.position = 'absolute';
          number.style.left = '0';
          number.style.color = 'rgb(var(--color-border-active))';
          number.style.fontWeight = 'bold';
          
          // Insert at the beginning
          item.insertBefore(number, item.firstChild);
        });
      }
    }
    
    // Style back arrows with green color and remove underline
    const footnoteBackrefs = markdownBody.querySelectorAll('[data-footnote-backref]');
    footnoteBackrefs.forEach(backref => {
      backref.style.color = 'rgb(var(--color-border-active))';
      backref.style.textDecoration = 'none';
      
      // Remove underline on hover
      backref.addEventListener('mouseenter', () => {
        backref.style.textDecoration = 'none';
      });
      
      backref.addEventListener('mouseleave', () => {
        backref.style.textDecoration = 'none';
      });
    });

    var links = markdownBody.querySelectorAll("a");
    // 循环遍历链接标签
    for (var i = 0; i < links.length; i++) {
      // 给每个链接标签添加 target 属性
      let names = links[i].getAttributeNames()
      if (!names.includes('data-footnote-backref') && !names.includes('data-footnote-ref')) {
        links[i].setAttribute("target", "_blank");
        links[i].setAttribute("rel", "nofollow noreferrer");
      }
    }
  }
</script>
