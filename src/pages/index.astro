---
import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import HomePage from '@/components/HomePage.astro';
import FeaturedPosts from '@/components/FeaturedPosts.astro';
import {getCollectionByName} from "@/utils/getCollectionByName";
import {orderBySticky} from "@/utils/orderBySticky";
import {site, config} from '@/consts';

// Get blog posts
let blogs = await getCollectionByName("blog");
let sortedPosts = orderBySticky(blogs);

// Count total blogs
const totalBlogs = blogs.length;

// Manual featured articles - add slugs here to manually feature specific articles
// If empty, will use sticky posts or most recent
const manualFeaturedSlugs: string[] = [];

// Get featured posts
const featuredPosts = manualFeaturedSlugs.length > 0
  ? blogs.filter((b: any) => manualFeaturedSlugs.includes(b.slug)).slice(0, 3)
  : sortedPosts.slice(0, 3);
---

<html lang={config.lang}>
<BaseHead title={site.title} description={site.description} />

<body class="bg-skin-secondary relative">
<Header/>
<main class="min-h-screen pb-32 relative">
  <!-- Hero and Main Content -->
  <HomePage totalBlogs={totalBlogs} />
  
  <!-- Featured Blog Posts -->
  <FeaturedPosts posts={featuredPosts} />
  
  <Footer/>
</main>
</body>
</html>
